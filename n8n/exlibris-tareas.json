    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n \"type\": \"object\",\n \"properties\": {\n  \"genero\": {\n   \"type\": \"string\",\n   \"enum\": [\n    \"Novela\",\n    \"Cuento\",\n    \"Poesía\",\n    \"Teatro\",\n    \"Fantasía\",\n    \"Ciencia ficción\",\n    \"Misterio y policial\",\n    \"Terror\",\n    \"Romance\",\n    \"Novela histórica\",\n    \"Clásicos\",\n    \"Juvenil\",\n    \"Infantil\",\n    \"Cómic y manga\",\n    \"Biografía y memorias\",\n    \"Ensayo\",\n    \"Historia\",\n    \"Filosofía\",\n    \"Psicología\",\n    \"Desarrollo personal\",\n    \"Ciencia\",\n    \"Tecnología\",\n    \"Negocios y economía\",\n    \"Arte y diseño\",\n    \"Religión y espiritualidad\",\n    \"Cocina\",\n    \"Viajes\",\n    \"Educación y estudio\",\n    \"Otro\"\n   ]\n  },\n  \"etiquetas\": {\n   \"type\": \"array\",\n   \"items\": {\n    \"type\": \"string\"\n   },\n   \"maxItems\": 5\n  }\n },\n \"required\": [\n  \"genero\",\n  \"etiquetas\"\n ]\n}"
      },
