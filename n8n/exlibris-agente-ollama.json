{
  "name": "Ex Libris · Agente (Ollama)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "exlibris-agente",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "3251b556-df60-52e3-872b-0145e59ebb31",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "83d5d1ca-0e50-5688-a99e-dae4c37714d4"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.body.mensaje }}",
        "options": {
          "systemMessage": "=Eres el asistente de «Ex Libris», la biblioteca personal de {{ $('Webhook').item.json.body.persona.nombre }} ({{ $('Webhook').item.json.body.persona.tratamiento }}).\nHoy es {{ $now.toFormat('dd/MM/yyyy') }}.\n\n- Responde siempre en español, de forma breve y amable.\n- Para cualquier dato de su biblioteca USA LAS HERRAMIENTAS: nunca inventes libros, personas, fechas ni anotaciones.\n- En la app los préstamos se llaman «compartidos»: di siempre «compartido» (nunca «prestado»). Usa la herramienta de compartidos para saber quién tiene un libro y desde hace cuántos días.\n- Puedes usar **negrita** y listas con «*» para ordenar la respuesta.\n- Si te piden recomendaciones, básate en los géneros y calificaciones de lo que ya leyó; puedes sugerir libros que no tiene, pero aclara que no están en su biblioteca.\n- Si una herramienta no encuentra nada, dilo con honestidad."
        }
      },
      "id": "494969fd-3623-5031-a405-2e7221631e52",
      "name": "Agente Ex Libris",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        260,
        0
      ]
    },
    {
      "parameters": {
        "model": "llama3.2",
        "options": {
          "temperature": 0.3
        }
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOllama",
      "typeVersion": 1,
      "id": "6537009f-e2a0-50d1-87c5-58b79f7b91f7",
      "name": "Modelo",
      "position": [
        100,
        260
      ]
    },
    {
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $('Webhook').item.json.body.sesion }}",
        "contextWindowLength": 10
      },
      "id": "62c5431c-984b-5b74-ab25-82702b540911",
      "name": "Memoria",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [
        260,
        260
      ]
    },
    {
      "parameters": {
        "toolDescription": "Busca libros de la biblioteca. Devuelve título, autor, género, estado (Por leer, Leyendo, Leído), progreso, calificación, número de anotaciones y con quién está compartido. Sin parámetros devuelve todos.",
        "method": "GET",
        "url": "={{ $('Webhook').item.json.body.api }}/libros/",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "parametersHeaders": {
          "values": [
            {
              "name": "X-ExLibris-Token",
              "valueProvider": "fieldValue",
              "value": "={{ $('Webhook').item.json.body.token }}"
            }
          ]
        },
        "optimizeResponse": false,
        "sendQuery": true,
        "specifyQuery": "keypair",
        "parametersQuery": {
          "values": [
            {
              "name": "q",
              "valueProvider": "modelOptional",
              "description": "texto a buscar en título, autor o ISBN"
            },
            {
              "name": "estado",
              "valueProvider": "modelOptional",
              "description": "por_leer, leyendo o leido"
            },
            {
              "name": "genero",
              "valueProvider": "modelOptional",
              "description": "género exacto, p. ej. Novela"
            }
          ]
        }
      },
      "id": "69cd546e-e470-56ce-928e-456f911a187a",
      "name": "buscar_libros",
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "position": [
        420,
        260
      ]
    },
    {
      "parameters": {
        "toolDescription": "Muestra el detalle de un libro por su id (de buscar_libros): descripción, reseña, anotaciones, resumen de notas e historial de compartidos.",
        "method": "GET",
        "url": "={{ $('Webhook').item.json.body.api }}/libros/{id}/",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "parametersHeaders": {
          "values": [
            {
              "name": "X-ExLibris-Token",
              "valueProvider": "fieldValue",
              "value": "={{ $('Webhook').item.json.body.token }}"
            }
          ]
        },
        "optimizeResponse": false,
        "placeholderDefinitions": {
          "values": [
            {
              "name": "id",
              "description": "id numérico del libro",
              "type": "number"
            }
          ]
        }
      },
      "id": "9fca4cd4-cb6e-5d25-b4d3-34c82d6f9a15",
      "name": "ver_libro",
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
